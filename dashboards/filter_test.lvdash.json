    {
      "name": "18872922",
      "displayName": "top_products",
      "queryLines": [
        "SELECT\n",
        "  product,\n",
        "  ROUND(CAST(net_revenue AS DOUBLE) / 1e6, 2) AS lkr_m,\n",
        "  CAST(units AS DOUBLE) AS units\n",
        "FROM (\n",
        "  SELECT `product`, MEASURE(`net_revenue`) AS `net_revenue`, MEASURE(`units`) AS `units`\n",
        "  FROM sales_dev.gold.sales_metrics\n",
        "  WHERE is_fiscal_year_to_date AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS q\n",
        "ORDER BY lkr_m DESC\n",
        "LIMIT 10"
