{
  "datasets": [
    {
      "name": "24a39f1d",
      "displayName": "province_values",
      "queryLines": [
        "SELECT province FROM (\n",
        "  SELECT 'All' AS province, 0 AS sort_order\n",
        "  UNION ALL\n",
        "  SELECT DISTINCT province, 1 AS sort_order FROM sales_dev.gold.dim_region WHERE province IS NOT NULL\n",
        ") AS v\n",
        "ORDER BY sort_order, province"
      ]
    },
    {
      "name": "c90393e4",
      "displayName": "product_group_values",
      "queryLines": [
        "SELECT product_group FROM (\n",
        "  SELECT 'All' AS product_group, 0 AS sort_order\n",
        "  UNION ALL\n",
        "  SELECT DISTINCT product_group_name, 1 AS sort_order FROM sales_dev.gold.dim_product WHERE product_group_name IS NOT NULL\n",
        ") AS v\n",
        "ORDER BY sort_order, product_group"
      ]
    },
    {
      "name": "8c250111",
      "displayName": "headline",
      "queryLines": [
        "SELECT\n",
        "  CAST(net_revenue AS DOUBLE) AS net_revenue,\n",
        "  CAST(active_customers AS DOUBLE) AS active_customers,\n",
        "  CAST(invoice_count AS DOUBLE) AS invoice_count\n",
        "FROM (\n",
        "  SELECT MEASURE(`net_revenue`) AS `net_revenue`, MEASURE(`active_customers`) AS `active_customers`, MEASURE(`invoice_count`) AS `invoice_count`\n",
        "  FROM sales_dev.gold.sales_metrics\n",
        "  WHERE is_fiscal_year_to_date AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        ") AS q"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "product_group",
          "keyword": "product_group",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "6348ac48",
      "displayName": "by_month",
      "queryLines": [
        "SELECT\n",
        "  month,\n",
        "  ROUND(CAST(net_revenue AS DOUBLE) / 1e6, 1) AS lkr_m\n",
        "FROM (\n",
        "  SELECT `month`, MEASURE(`net_revenue`) AS `net_revenue`\n",
        "  FROM sales_dev.gold.sales_metrics\n",
        "  WHERE is_current_fiscal_year AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS q\n",
        "ORDER BY month"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
