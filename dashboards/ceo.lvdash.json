{
  "datasets": [
    {
      "name": "44ec0be9",
      "displayName": "sales_fytd",
      "queryLines": [
        "SELECT\n",
        "  CAST(MAX(net_revenue) FILTER (WHERE is_fiscal_year_to_date) AS DOUBLE) AS revenue_fytd,\n",
        "  CAST(ROUND((MAX(net_revenue) FILTER (WHERE is_fiscal_year_to_date) / NULLIF(MAX(net_revenue) FILTER (WHERE NOT is_fiscal_year_to_date), 0) - 1) * 100, 1) AS DOUBLE) AS revenue_change_pct,\n",
        "  CAST(ROUND(MAX(gross_margin_pct) FILTER (WHERE is_fiscal_year_to_date), 1) AS DOUBLE) AS margin_pct_fytd\n",
        "FROM (\n",
        "  SELECT `is_fiscal_year_to_date`, MEASURE(`net_revenue`) AS `net_revenue`, MEASURE(`gross_margin_pct`) AS `gross_margin_pct`, MEASURE(`active_customers`) AS `active_customers`\n",
        "  FROM sales_dev.gold.sales_metrics\n",
        "  WHERE is_fiscal_year_to_date OR is_same_period_last_fiscal_year\n",
        "  GROUP BY ALL\n",
        ") AS q"
      ]
    },
    {
      "name": "6ef3f1ac",
      "displayName": "stock_today",
      "queryLines": [
        "SELECT\n",
        "  CAST(stock_value AS DOUBLE) AS stock_value,\n",
        "  CAST(in_transit AS DOUBLE) AS in_transit,\n",
        "  CAST(ROUND(days_of_cover, 1) AS DOUBLE) AS days_of_cover,\n",
        "  CAST(stock_out_positions AS DOUBLE) AS stock_out_positions,\n",
        "  CAST(low_cover_positions AS DOUBLE) AS low_cover_positions,\n",
        "  CAST(ROUND(stock_out_rate_pct, 2) AS DOUBLE) AS stock_out_rate_pct\n",
        "FROM (\n",
        "  SELECT MEASURE(`stock_value`) AS `stock_value`, MEASURE(`in_transit`) AS `in_transit`, MEASURE(`days_of_cover`) AS `days_of_cover`, MEASURE(`stock_out_positions`) AS `stock_out_positions`, MEASURE(`low_cover_positions`) AS `low_cover_positions`, MEASURE(`stock_out_rate_pct`) AS `stock_out_rate_pct`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        ") AS q"
      ]
    },
    {
      "name": "4ab6b5b8",
      "displayName": "revenue_trend",
      "queryLines": [
        "WITH last_full AS (\n",
        "  SELECT MAX(month_start_date) AS m FROM sales_dev.gold.dim_date WHERE is_last_complete_month\n",
        "),\n",
        "actual AS (\n",
        "  SELECT d.month_start_date AS month, SUM(f.net_revenue_amount) AS amount\n",
        "  FROM sales_dev.gold.fact_sales f\n",
        "  JOIN sales_dev.gold.dim_date d ON f.invoice_date = d.date\n",
        "  CROSS JOIN last_full\n",
        "  WHERE d.month_start_date BETWEEN add_months(last_full.m, -12) AND last_full.m\n",
        "  GROUP BY d.month_start_date\n",
        ")\n",
        "SELECT month, 'Actual' AS series, ROUND(CAST(amount AS DOUBLE) / 1e6, 1) AS lkr_m FROM actual\n",
        "UNION ALL\n",
        "SELECT month_start_date, s.series, ROUND(s.amount / 1e6, 1)\n",
        "FROM sales_dev.gold.forecast\n",
        "LATERAL VIEW stack(3, 'Forecast', CAST(forecast_net_revenue AS DOUBLE),\n",
        "                      'Forecast low', CAST(low_net_revenue AS DOUBLE),\n",
        "                      'Forecast high', CAST(high_net_revenue AS DOUBLE)) s AS series, amount"
      ]
    },
    {
      "name": "a3283fde",
      "displayName": "province_mtd",
      "queryLines": [
        "SELECT\n",
        "  province,\n",
        "  ROUND(CAST(net_revenue AS DOUBLE) / 1e6, 1) AS lkr_m,\n",
        "  CAST(units_sold AS DOUBLE) AS units_sold,\n",
        "  CAST(stock_out_days AS DOUBLE) AS stock_out_days,\n",
        "  CAST(ROUND(depot_days_of_cover, 1) AS DOUBLE) AS days_of_cover\n",
        "FROM (\n",
        "  SELECT `province`, MEASURE(`net_revenue`) AS `net_revenue`, MEASURE(`units_sold`) AS `units_sold`, MEASURE(`stock_out_days`) AS `stock_out_days`, MEASURE(`depot_days_of_cover`) AS `depot_days_of_cover`\n",
        "  FROM inventory_dev.gold.sales_and_stock\n",
        "  WHERE is_month_to_date AND province IS NOT NULL\n",
        "  GROUP BY ALL\n",
        ") AS q\n",
        "ORDER BY lkr_m DESC"
      ]
    },
    {
      "name": "3ea48750",
      "displayName": "top_findings",
      "queryLines": [
        "WITH s AS (SELECT max_by(run_id, generated_ts) AS run_id FROM sales_dev.gold.insights),\n",
        "k AS (SELECT max_by(run_id, generated_ts) AS run_id FROM inventory_dev.gold.insights),\n",
        "findings AS (\n",
        "  SELECT 'Sales' AS area, i.severity, i.kind, i.change, i.text\n",
        "  FROM sales_dev.gold.insights i JOIN s ON i.run_id = s.run_id\n",
        "  WHERE i.kind IN ('revenue_drop', 'stock_out', 'anomaly')\n",
        "     OR (i.kind = 'headline' AND i.metric = 'net_revenue' AND i.comparison = 'mtd_vs_last_year')\n",
        "     OR (i.kind = 'forecast' AND i.dimension = 'month')\n",
        "  UNION ALL\n",
        "  SELECT 'Stock', i.severity, i.kind, i.change, i.text\n",
        "  FROM inventory_dev.gold.insights i JOIN k ON i.run_id = k.run_id\n",
        "  WHERE i.kind IN ('stock_out_confirmed', 'overstock_total')\n",
        ")\n",
        "SELECT CASE severity WHEN 1 THEN 'Act now' WHEN 2 THEN 'Notable' ELSE 'Context' END AS priority,\n",
        "       area, text AS finding,\n",
        "       ROW_NUMBER() OVER (ORDER BY severity, area, abs(change) DESC) AS row_order\n",
        "FROM findings\n",
        "ORDER BY row_order\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "caf07220",
      "displayName": "trust",
      "queryLines": [
        "WITH sales AS (\n",
        "  SELECT SUM(CASE WHEN status = 'PASS' THEN 1 ELSE 0 END) AS ok, COUNT(*) AS n FROM sales_dev.ops.reconciliation\n",
        "  WHERE run_id = (SELECT max_by(run_id, checked_ts) FROM sales_dev.ops.reconciliation)\n",
        "),\n",
        "stock AS (\n",
        "  SELECT SUM(CASE WHEN status = 'PASS' THEN 1 ELSE 0 END) AS ok, COUNT(*) AS n FROM inventory_dev.ops.reconciliation\n",
        "  WHERE run_id = (SELECT max_by(run_id, checked_ts) FROM inventory_dev.ops.reconciliation)\n",
        "),\n",
        "dates AS (\n",
        "  SELECT (SELECT MAX(invoice_date) FROM sales_dev.gold.fact_sales) AS sales_d,\n",
        "         (SELECT MAX(snapshot_date) FROM inventory_dev.gold.fact_stock_daily) AS stock_d\n",
        ")\n",
        "SELECT concat('Sales up to ', date_format(dates.sales_d, 'd MMM yyyy'), ' (', CAST(sales.ok AS STRING), '/', CAST(sales.n AS STRING),\n",
        "              ' checks passed)  |  Stock up to ', date_format(dates.stock_d, 'd MMM yyyy'), ' (',\n",
        "              CAST(stock.ok AS STRING), '/', CAST(stock.n AS STRING), ' checks passed)') AS status\n",
        "FROM sales CROSS JOIN stock CROSS JOIN dates"
      ]
    }
  ],
