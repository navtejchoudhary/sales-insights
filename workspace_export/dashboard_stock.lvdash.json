    {
      "name": "0903d1c7",
      "displayName": "stock_out_days_by_depot",
      "queryLines": [
        "SELECT\n",
        "  location,\n",
        "  CAST(stock_out_days AS DOUBLE) AS stock_out_days\n",
        "FROM (\n",
        "  SELECT `location`, MEASURE(`stock_out_days`) AS `stock_out_days`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        "  WHERE (is_month_to_date AND location_type = 'Depot') AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS q"
      ],
      "parameters": [
        {
          "displayName": "province",
