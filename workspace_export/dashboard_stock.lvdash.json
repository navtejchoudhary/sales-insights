{
  "datasets": [
    {
      "name": "90a6c9c8",
      "displayName": "province_values",
      "queryLines": [
        "SELECT province FROM (\n",
        "  SELECT 'All' AS province, 0 AS sort_order\n",
        "  UNION ALL\n",
        "  SELECT DISTINCT province, 1 AS sort_order FROM inventory_dev.gold.dim_location WHERE province IS NOT NULL\n",
        ") AS v\n",
        "ORDER BY sort_order, province"
      ]
    },
    {
      "name": "0d453175",
      "displayName": "product_group_values",
      "queryLines": [
        "SELECT product_group FROM (\n",
        "  SELECT 'All' AS product_group, 0 AS sort_order\n",
        "  UNION ALL\n",
        "  SELECT DISTINCT product_group_name, 1 AS sort_order FROM sales_dev.gold.dim_product WHERE product_group_name IS NOT NULL\n",
        ") AS v\n",
        "ORDER BY sort_order, product_group"
      ]
    },
    {
      "name": "4da38200",
      "displayName": "stock_today",
      "queryLines": [
        "SELECT\n",
        "  CAST(stock_value AS DOUBLE) AS stock_value,\n",
        "  CAST(in_transit AS DOUBLE) AS in_transit,\n",
        "  CAST(ROUND(days_of_cover, 1) AS DOUBLE) AS days_of_cover,\n",
        "  CAST(stock_out_positions AS DOUBLE) AS stock_out_positions,\n",
        "  CAST(low_cover_positions AS DOUBLE) AS low_cover_positions,\n",
        "  CAST(ROUND(stock_out_rate_pct, 2) AS DOUBLE) AS stock_out_rate_pct\n",
        "FROM (\n",
        "  SELECT MEASURE(`stock_value`) AS `stock_value`, MEASURE(`in_transit`) AS `in_transit`, MEASURE(`days_of_cover`) AS `days_of_cover`, MEASURE(`stock_out_positions`) AS `stock_out_positions`, MEASURE(`low_cover_positions`) AS `low_cover_positions`, MEASURE(`stock_out_rate_pct`) AS `stock_out_rate_pct`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        "  WHERE (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        ") AS q"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "product_group",
          "keyword": "product_group",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "9fa8d3d0",
      "displayName": "positions_by_day",
      "queryLines": [
        "SELECT snapshot_date, s.series, s.positions\n",
        "FROM (\n",
        "  SELECT `snapshot_date`, MEASURE(`stock_out_positions`) AS `stock_out_positions`, MEASURE(`low_cover_positions`) AS `low_cover_positions`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        "  WHERE (is_current_fiscal_year) AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS previous\n",
        "LATERAL VIEW stack(2, 'Stock-outs', CAST(stock_out_positions AS DOUBLE),\n",
        "                      'Low cover (under 7 days)', CAST(low_cover_positions AS DOUBLE)) s AS series, positions"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "product_group",
          "keyword": "product_group",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "fa168f6b",
      "displayName": "value_by_location",
      "queryLines": [
        "SELECT\n",
        "  location,\n",
        "  location_type,\n",
        "  ROUND(CAST(stock_value AS DOUBLE) / 1e6, 2) AS lkr_m\n",
        "FROM (\n",
        "  SELECT `location`, `location_type`, MEASURE(`stock_value`) AS `stock_value`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        "  WHERE (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS q"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        },
        {
          "displayName": "product_group",
          "keyword": "product_group",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "All"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "449e4e31",
      "displayName": "depot_cover_by_group",
      "queryLines": [
        "SELECT\n",
        "  product_group,\n",
        "  CAST(ROUND(days_of_cover, 1) AS DOUBLE) AS days_of_cover,\n",
        "  CAST(stock_out_positions AS DOUBLE) AS stock_out_positions\n",
        "FROM (\n",
        "  SELECT `product_group`, MEASURE(`days_of_cover`) AS `days_of_cover`, MEASURE(`stock_out_positions`) AS `stock_out_positions`\n",
        "  FROM inventory_dev.gold.inventory_metrics\n",
        "  WHERE (location_type = 'Depot') AND (:province = 'All' OR province = :province) AND (:product_group = 'All' OR product_group = :product_group)\n",
        "  GROUP BY ALL\n",
        ") AS q"
      ],
      "parameters": [
        {
          "displayName": "province",
          "keyword": "province",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
