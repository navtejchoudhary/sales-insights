    {
      "name": "ae9bc525",
      "displayName": "stock_findings",
      "queryLines": [
        "WITH latest AS (SELECT max_by(run_id, generated_ts) AS run_id FROM inventory_dev.gold.insights)\n",
        "SELECT CASE i.severity WHEN 1 THEN 'Act now' WHEN 2 THEN 'Notable' ELSE 'Context' END AS priority,\n",
        "       CASE i.kind WHEN 'stock_out_confirmed' THEN 'Stock-out' WHEN 'low_cover' THEN 'Low cover'\n",
        "                   ELSE 'Overstock' END AS type,\n",
        "       i.text AS finding,\n",
        "       ROW_NUMBER() OVER (ORDER BY i.severity, CASE WHEN i.kind = 'overstock_total' THEN 0 ELSE 1 END,\n",
        "                                   i.item) AS row_order\n",
        "FROM inventory_dev.gold.insights i\n",
        "JOIN latest ON i.run_id = latest.run_id\n",
        "ORDER BY row_order"
      ]
    },
    {
      "name": "07c9c4c4",
      "displayName": "stock_trust",
      "queryLines": [
        "WITH latest AS (SELECT MAX(snapshot_date) AS d FROM inventory_dev.gold.fact_stock_daily),\n",
        "rec AS (\n",
        "  SELECT SUM(CASE WHEN status = 'PASS' THEN 1 ELSE 0 END) AS ok, COUNT(*) AS n FROM inventory_dev.ops.reconciliation\n",
        "  WHERE run_id = (SELECT max_by(run_id, checked_ts) FROM inventory_dev.ops.reconciliation)\n",
        "),\n",
        "rf AS (\n",
        "  SELECT SUM(checked - failed) AS ok, SUM(checked) AS n FROM inventory_dev.ops.stock_rollforward\n",
        "  WHERE run_id = (SELECT max_by(run_id, checked_ts) FROM inventory_dev.ops.stock_rollforward)\n",
        "),\n",
        "xc AS (\n",
        "  SELECT SUM(checked - failed) AS ok, SUM(checked) AS n FROM inventory_dev.ops.cross_checks\n",
        "  WHERE run_id = (SELECT max_by(run_id, checked_ts) FROM inventory_dev.ops.cross_checks)\n",
        ")\n",
        "SELECT concat('Stock data up to ', date_format(latest.d, 'd MMM yyyy'),\n",
        "              '  |  totals vs source ', CAST(rec.ok AS STRING), '/', CAST(rec.n AS STRING),\n",
        "              '  |  stock roll-forward ', CAST(rf.ok AS STRING), '/', CAST(rf.n AS STRING),\n",
        "              '  |  cross-check with sales ', CAST(xc.ok AS STRING), '/', CAST(xc.n AS STRING), ' passed') AS status\n",
        "FROM latest CROSS JOIN rec CROSS JOIN rf CROSS JOIN xc"
      ]
    }
  ],
